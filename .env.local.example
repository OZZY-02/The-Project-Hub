# Required — the app fails with an explicit setup error without these.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional — server-side features.
OPENAI_API_KEY="your-openai-api-key"          # /api/portfolio/ai-edit
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# TEMPORARY — remove before launch.
# Skips the client auth guard so the app can be demoed without signing in.
# Ignored in production builds. See src/components/AuthGuard.tsx.
NEXT_PUBLIC_FOUNDER_MODE="false"
